{
  "license": "MIT",
  "name": "@ankhorage/orchestrator-module-expo-localization",
  "version": "0.7.1",
  "description": "Expo localization module for @ankhorage/orchestrator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/ankhorage/orchestrator-module-expo-localization#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/orchestrator-module-expo-localization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/orchestrator-module-expo-localization.git"
  },
  "keywords": [
    "ankhorage",
    "expo",
    "i18n",
    "localization",
    "orchestrator-module",
    "react-native",
    "typescript"
  ],
  "sideEffects": false,
  "ankh": {
    "category": "expo-localization",
    "provider": null,
    "capabilities": [
      {
        "id": "localization.setLanguage",
        "owner": "@ankhorage/orchestrator-module-expo-localization",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Set language",
        "description": "Change the active application language.",
        "input": {
          "schema": {
            "type": "object",
            "required": [
              "locale"
            ],
            "properties": {
              "locale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    ]
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./admin-view": {
      "types": "./dist/admin-view/index.d.ts",
      "default": "./dist/admin-view/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.scripts.json",
    "validate:sdk57-consumer": "bun scripts/validateSdk57Consumer.ts",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "changeset": "ankhorage-changeset",
    "docs": "ankhorage-prettier --check README.md",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/capability": "^0.2.1",
    "@ankhorage/contracts": "^25.0.0",
    "@ankhorage/expo-runtime": "^6.0.0",
    "@ankhorage/orchestrator": "^0.4.1"
  },
  "peerDependencies": {
    "@ankhorage/zora": "^24.1.2",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@ankhorage/zora": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.6",
    "@ankhorage/zora": "^24.1.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  }
}
